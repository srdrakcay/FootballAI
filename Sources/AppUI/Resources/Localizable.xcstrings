    "analysis.ineligible.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Analyses can be opened until shortly before kickoff, for matches that are still scheduled."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Analizler, planlanan maçlar için başlama saatinden kısa süre öncesine kadar açılabilir."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Analysen sind bis kurz vor Anpfiff für angesetzte Spiele verfügbar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los análisis se pueden abrir hasta poco antes del inicio de partidos programados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les analyses sont disponibles jusqu’à peu avant le coup d’envoi des matchs programmés."
          }
        }
      }
    },
