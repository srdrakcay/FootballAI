    "a11y.outcome_bar %lld %lld %lld": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Home %1$lld percent, draw %2$lld percent, away %3$lld percent"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ev sahibi yüzde %1$lld, beraberlik yüzde %2$lld, deplasman yüzde %3$lld"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Heim %1$lld Prozent, Remis %2$lld Prozent, Auswärts %3$lld Prozent"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Local %1$lld por ciento, empate %2$lld por ciento, visitante %3$lld por ciento"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Domicile %1$lld pour cent, nul %2$lld pour cent, extérieur %3$lld pour cent"
          }
        }
      }
    },
    "analysis.disclaimer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Probabilities are tendencies, not guaranteed outcomes or betting advice."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Olasılıklar bir eğilimdir; kesin sonuç veya bahis tavsiyesi değildir."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wahrscheinlichkeiten sind Tendenzen, keine garantierten Ergebnisse oder Wettempfehlungen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las probabilidades son tendencias, no resultados garantizados ni consejos de apuestas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les probabilités sont des tendances, pas des résultats garantis ni des conseils de paris."
          }
        }
      }
    },
    "analysis.draw": {
