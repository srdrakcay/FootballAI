        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine anonyme Sitzung wird von diesem Gerät entfernt. Credits bleiben im Konto, sind ohne die Sitzung aber nicht wiederherstellbar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
