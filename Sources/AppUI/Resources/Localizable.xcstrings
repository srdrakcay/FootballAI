    },
    "analysis.error.generic": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Something went wrong on our side. No credit was spent."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bizim tarafımızda bir sorun oluştu. Kredi düşülmedi."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bei uns ist etwas schiefgelaufen. Es wurde kein Credit abgebucht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Algo falló por nuestra parte. No se ha cobrado ningún crédito."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un problème est survenu de notre côté. Aucun crédit n’a été débité."
          }
        }
      }
    },
    "analysis.error.in_progress": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This analysis is already being prepared. Try again in a moment."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu analiz zaten hazırlanıyor. Birazdan tekrar dene."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Analyse wird bereits erstellt. Versuche es gleich erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este análisis ya se está preparando. Inténtalo en un momento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette analyse est déjà en préparation. Réessayez dans un instant."
          }
        }
      }
    },
    "analysis.error.offline": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You seem to be offline. No credit was spent."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bağlantı yok gibi görünüyor. Kredi düşülmedi."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du scheinst offline zu sein. Es wurde kein Credit abgebucht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Parece que no tienes conexión. No se ha cobrado ningún crédito."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous semblez hors ligne. Aucun crédit n’a été débité."
          }
        }
      }
    },
