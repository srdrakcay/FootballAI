      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your anonymous session is removed from this device. Credits stay on the account but can’t be recovered without it."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Anonim oturum bu cihazdan kaldırılır. Krediler hesapta kalır ancak bu oturum olmadan geri alınamaz."
